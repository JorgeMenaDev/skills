---
// The sticky stage: posters under clips, a stop rail, and the stops (default slot) scrolling over it.
import { stops } from '../data/stops';

const clips = Array.from({ length: stops.length - 1 }, (_, i) => i + 1);
interface Props { label: string }
const { label } = Astro.props;
---

<section data-film aria-label={label} class="film">
  <div data-film-stage class="film-stage" style="--film-focus: 50%">
    <div aria-hidden="true" class="film-layer">
      {stops.map((_, i) => (
        <div data-film-poster class="film-layer" style={i === 0 ? undefined : 'opacity: 0'}>
          <img
            src={`/film/poster-${i}.webp`}
            srcset={`/film/poster-${i}-960.webp 960w, /film/poster-${i}.webp 1920w`}
            sizes="(min-aspect-ratio: 16/9) 100vw, 178lvh"
            alt=""
            width="1920"
            height="1080"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
            class="film-media"
          />
        </div>
      ))}
      <div class="film-layer film-clips">
        {clips.map((n) => (
          <video
            data-film-clip
            data-src={`/film/clip-${n}.mp4`}
            data-src-small={`/film/clip-${n}-720.mp4`}
            muted
            playsinline
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            tabindex="-1"
            class="film-media film-clip"
          />
        ))}
      </div>
    </div>

    <nav aria-label="Film stops" class="film-rail">
      <ol>
        {stops.map((stop, i) => (
          <li>
            <a href={`#${stop.id}`} data-film-goto aria-current={i === 0 ? 'true' : 'false'}>
              <span class="film-rail-label">{stop.place}</span>
              <span class="film-rail-dot"></span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <div class="film-stops">
    <slot />
  </div>
</section>

<style>
  .film { position: relative; }
  .film-stage { position: sticky; top: 0; height: 100lvh; overflow: hidden; background: #111; }
  .film-layer { position: absolute; inset: 0; }
  .film-media { width: 100%; height: 100%; object-fit: cover; object-position: var(--film-focus) 50%; }
  .film-clips { opacity: 0; transition: opacity 400ms cubic-bezier(0.32, 0.72, 0, 1); }
  [data-mode='video'] .film-clips { opacity: 1; }
  /* Only the active clip is visible; neighbours share a frame at each stop, so the switch is invisible. */
  .film-clip { position: absolute; inset: 0; visibility: hidden; }
  .film-clip:global(.is-on) { visibility: visible; }
  .film-stops { position: relative; z-index: 1; margin-top: -100lvh; }

  .film-rail { position: absolute; top: 50%; right: 24px; transform: translateY(-50%); display: none; }
  @media (min-width: 1024px) { .film-rail { display: block; } }
  .film-rail ol { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .film-rail a { display: flex; align-items: center; gap: 12px; height: 24px; color: #fff; text-decoration: none; }
  .film-rail-label { opacity: 0; padding: 4px 10px; border-radius: 6px; background: #000; font-size: 12px; transition: opacity 150ms; }
  .film-rail a:hover .film-rail-label, .film-rail a:focus-visible .film-rail-label, .film-rail a[aria-current='true'] .film-rail-label { opacity: 1; }
  .film-rail-dot { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 60%); }
  .film-rail a[aria-current='true'] .film-rail-dot { background: #fff; }
</style>
