---
// One stop. The article is the scroll distance for the segment that starts here; the panel sticks to the
// bottom left while the camera moves and is pushed out by the next stop. Put the caption and its card inside.
import { stops } from '../data/stops';

interface Props { index: number }
const { index } = Astro.props;
const stop = stops[index];
---

<article id={stop.id} data-film-stop data-focus={stop.focus} class="stop">
  <div class="stop-body">
    <div class="stop-panel"><slot /></div>
  </div>
</article>

<style>
  .stop { display: flex; flex-direction: column; justify-content: flex-end; min-height: 200svh; pointer-events: none; }
  .stop-body { position: sticky; bottom: 0; padding: 12px; }
  @media (min-width: 640px) { .stop-body { padding: 24px; } }
  @media (min-width: 1024px) { .stop-body { padding: 40px; } }
  /* Restyle the panel in the product's design canon: solid surface, its radius and shadow. */
  .stop-panel {
    pointer-events: auto; max-width: 460px; padding: 24px; border-radius: 10px;
    background: #fff; color: #18181b; box-shadow: 0 12px 28px -18px rgb(0 0 0 / 40%);
    transition: opacity 400ms cubic-bezier(0.32, 0.72, 0, 1), transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  /* Once the film has mounted, only the current stop's panel shows. Without JS every panel stays visible. */
  :global([data-film][data-ready]) .stop:not([data-current]) .stop-panel:not(:focus-within) {
    opacity: 0; transform: translateY(12px); pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .stop-panel { transform: none !important; transition-duration: 150ms; } }
</style>
